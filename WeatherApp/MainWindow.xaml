<Window x:Name="window" x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:local="clr-namespace:WeatherApp"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=DotNetProjects.Input.Toolkit"
                 mc:Ignorable="d"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Width="1080" Height="720" KeyDown="Window_KeyDown">
    <Window.Resources>
        <DataTemplate x:Key="HourlyTemplate">
            <Border x:Name="HourlyBorder" CornerRadius="5,5,5,5" Background="#59000000">
                <Grid HorizontalAlignment="Left" Height="125" VerticalAlignment="Center" Width="80">
                    <TextBlock Background="White" Width="2" Height="{Binding Height, ElementName=HourlyBorder}" Margin="0,0,76,0" Opacity="{Binding opacity}"/>
                    <TextBlock Text="{Binding timeString}" HorizontalAlignment="Center" FontSize="16" Height="18" TextWrapping="Wrap" VerticalAlignment="Top" Width="80" TextAlignment="Center" FontFamily="Comic Sans MS" Margin="3,0,0,0" FontWeight="Normal" Foreground="White"/>
                    <Image Source="{Binding image}" Height="50" Margin="3,25,0,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding temperatureString}" HorizontalAlignment="Center" FontSize="16" Height="18" TextWrapping="Wrap" VerticalAlignment="Top" Width="80" TextAlignment="Center" Margin="3,75,0,0" FontFamily="Comic Sans MS" Foreground="White"/>
                    <TextBlock Text="{Binding windString}" HorizontalAlignment="Center" FontSize="16" Height="18" TextWrapping="Wrap" VerticalAlignment="Top" Width="80" TextAlignment="Center" Margin="3,93,0,0" FontFamily="Comic Sans MS" Foreground="White"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="halfDayTemplate">
            <Border  Background="#59000000" BorderThickness="1,1,1,1" CornerRadius="10,10,10,10">
                <Grid>
                    <Image Stretch="UniformToFill" x:Name="MorningImage" Source="{Binding image}" Margin="5,5,0,0" HorizontalAlignment="Left" Width="60" Height="60" VerticalAlignment="Top"/>
                    <TextBlock Margin="4,70,0,0"  Text="{Binding minTempStr}"    HorizontalAlignment="Left" Width="60" Height="16" VerticalAlignment="Top" FontFamily="Comic Sans MS" TextWrapping="Wrap" Foreground="White"/>
                    <TextBlock Margin="4,86,0,0"  Text="{Binding maxTempStr}"    HorizontalAlignment="Left" Width="60" Height="16" VerticalAlignment="Top" FontFamily="Comic Sans MS" TextWrapping="Wrap" Foreground="White"/>
                    <TextBlock Margin="4,102,0,0" Text="{Binding rainStr}"       HorizontalAlignment="Left" Width="60" Height="16" VerticalAlignment="Top" FontFamily="Comic Sans MS" TextWrapping="Wrap" Foreground="White"/>
                    <TextBlock Margin="4,118,0,0" Text="{Binding meanRainPbStr}" HorizontalAlignment="Left" Width="60" Height="16" VerticalAlignment="Top" FontFamily="Comic Sans MS" TextWrapping="Wrap" Foreground="White"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="/Content/Background.jpg" TileMode="None"/>
    </Window.Background>

    <Viewbox Stretch="UniformToFill">
        <Grid ScrollViewer.CanContentScroll="True" Width="1080" Height="720">
            <!-- Search Bar -->
            <controls:AutoCompleteBox Grid.ColumnSpan="2" 
                                      Margin="114,5,114,0" 
                                      RenderTransformOrigin="0.5,0.5" 
                                      Height="25" 
                                      VerticalAlignment="Top"
                                      x:Name="SearchBar"
                                      SelectionChanged="SearchBar_SelectionChanged"
                                      FontFamily="Comic Sans MS"/>

            <!-- Title -->
            <TextBlock Text="{Binding title}" Foreground="White" FontSize="20" FontFamily="Comic Sans MS" HorizontalAlignment="Center" VerticalAlignment="Top" Height="33" Width="546" Margin="0,53,0,0" TextAlignment="Center"/>

            <!-- Half Day Resumes -->
            <!-- Today -->
            <Grid x:Name="HalfMain" Margin="114,156,0,0" Height="170" VerticalAlignment="Top" HorizontalAlignment="Left" Width="150">
                <TextBlock Text="Today: " TextAlignment="Center" Height="25" VerticalAlignment="Top" FontFamily="Comic Sans MS" FontSize="16" Foreground="White"/>
                <ItemsControl Margin="0,25,0,0" ItemsSource="{Binding todayResume}" ItemTemplate="{StaticResource halfDayTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- Tomorrow -->
            <Grid Margin="0,156,0,0" Height="{Binding Height, ElementName=HalfMain}" VerticalAlignment="Top" HorizontalAlignment="Center" Width="{Binding Width, ElementName=HalfMain}">
                <TextBlock Text="Tomorrow: " TextAlignment="Center" Height="25" VerticalAlignment="Top" FontFamily="Comic Sans MS" FontSize="16" Foreground="White"/>
                <ItemsControl Margin="0,25,0,0" ItemsSource="{Binding tomorrowResume}" ItemTemplate="{StaticResource halfDayTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- After Tomorrow -->
            <Grid Margin="816,156,0,0" Height="{Binding Height, ElementName=HalfMain}" VerticalAlignment="Top" HorizontalAlignment="Left" Width="{Binding Width, ElementName=HalfMain}">
                <TextBlock Text="In 2 days:" TextAlignment="Center" Height="25" VerticalAlignment="Top" FontFamily="Comic Sans MS" FontSize="16" Foreground="White"/>
                <ItemsControl Margin="0,25,0,0" ItemsSource="{Binding afterTomorrowResume}" ItemTemplate="{StaticResource halfDayTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- Hour by Hour Forecast -->
            <Grid Margin="10,400,47,0" Height="130">
                <TextBlock Width="110" HorizontalAlignment="Left" FontFamily="Comic Sans MS" FontSize="17" Foreground="White" TextAlignment="Right">
                    Hour  
                    <LineBreak/>
                    Image  
                    <LineBreak/>
                    <LineBreak/>
                    Temperature  
                    <LineBreak/>
                    Wind Speeds  
                    <LineBreak/>
                </TextBlock>
                <ScrollViewer Margin="100,0,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" CanContentScroll="True" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding AllHourlyWeathers}" ItemTemplate="{StaticResource HourlyTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Viewbox>

</Window>
