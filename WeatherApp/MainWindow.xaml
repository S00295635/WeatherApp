<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:ssoft='clr-namespace:SaeediSoftWpfUiControls;assembly=SaeediSoftWpfUiControls'
        xmlns:local="clr-namespace:WeatherApp"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=DotNetProjects.Input.Toolkit"
                 mc:Ignorable="d"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="450" Width="800"
        Background="LightSteelBlue" KeyDown="Window_KeyDown">
    <Window.Resources>
        <DataTemplate x:Key="HourlyTemplate">
            <Grid HorizontalAlignment="Left" Height="94" VerticalAlignment="Center" Width="58">
                <TextBlock Text="{Binding timeString}" HorizontalAlignment="Center" Height="16" TextWrapping="Wrap" VerticalAlignment="Top" Width="58" TextAlignment="Center"/>
                <Image Source="{Binding image}" Height="33" Margin="0,16,0,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding temperatureString}" HorizontalAlignment="Center" Height="16" TextWrapping="Wrap" VerticalAlignment="Top" Width="58" TextAlignment="Center" Margin="0,49,0,0"/>
                <TextBlock Text="{Binding windString}" HorizontalAlignment="Center" Height="16" TextWrapping="Wrap" VerticalAlignment="Top" Width="58" TextAlignment="Center" Margin="0,59,0,0"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="halfDayTemplate">
            <Grid>
                <Image x:Name="MorningImage" Source="{Binding image}" Margin="5,5,0,0" HorizontalAlignment="Left" Width="72" Height="68" VerticalAlignment="Top"/>
                <TextBlock Margin="4,82,0,0" TextWrapping="Wrap" Text="{Binding minTempStr}" HorizontalAlignment="Left" Width="72" Height="13" VerticalAlignment="Top"/>
                <TextBlock Margin="4,98,0,0" TextWrapping="Wrap" Text="{Binding maxTempStr}" HorizontalAlignment="Left" Width="72" Height="13" VerticalAlignment="Top"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <StackPanel Orientation="Vertical">
        <Grid ScrollViewer.CanContentScroll="True" Height="431">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="61*"/>
                <ColumnDefinition Width="97*"/>
            </Grid.ColumnDefinitions>
            <controls:AutoCompleteBox Grid.ColumnSpan="2" 
                                      Margin="114,5,114,0" 
                                      RenderTransformOrigin="0.5,0.5" 
                                      Height="27" 
                                      VerticalAlignment="Top"
                                      x:Name="SearchBar" SelectionChanged="SearchBar_SelectionChanged"
                                      >



            </controls:AutoCompleteBox>
            <Grid Margin="36,53,0,0" Height="164" VerticalAlignment="Top" HorizontalAlignment="Left" Width="172">
                <ItemsControl ItemsSource="{Binding halfDayResume}" ItemTemplate="{StaticResource halfDayTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
            <TextBlock x:Name="ForecastSummary" Margin="10,53,0,0" TextWrapping="Wrap" Text="TextBlock" HorizontalAlignment="Left" Width="460" Height="148" VerticalAlignment="Top" Grid.Column="1"/>
            <ScrollViewer Margin="10,247,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" CanContentScroll="True" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Height="131" VerticalAlignment="Top" HorizontalAlignment="Left" Width="780" Grid.ColumnSpan="2">
                <ItemsControl ItemsSource="{Binding AllHourlyWeathers}" ItemTemplate="{StaticResource HourlyTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </StackPanel>

</Window>
